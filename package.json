{
  "name": "otters-pay-paddle",
  "version": "0.1.0",
  "description": "Paddle Billing for Node servers: webhook verification (signature + sender IPs), provider-neutral subscription events, checkout config and customer portal links.",
  "license": "MIT",
  "author": "Otters Studio",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Otters-Studio/otters-pay-paddle.git"
  },
  "homepage": "https://github.com/Otters-Studio/otters-pay-paddle#readme",
  "bugs": {
    "url": "https://github.com/Otters-Studio/otters-pay-paddle/issues"
  },
  "type": "module",
  "keywords": [
    "paddle",
    "paddle-billing",
    "billing",
    "subscriptions",
    "webhooks",
    "merchant-of-record"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "packageManager": "pnpm@10.9.0",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7"
  }
}
